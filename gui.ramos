weave "src/eval.ramos"
weave "stdlib/gui.ramos"

fn calc_key(index: int64) -> string {
    if index == 0 { return s"7" }
    if index == 1 { return s"8" }
    if index == 2 { return s"9" }
    if index == 3 { return s"/" }
    if index == 4 { return s"4" }
    if index == 5 { return s"5" }
    if index == 6 { return s"6" }
    if index == 7 { return s"*" }
    if index == 8 { return s"1" }
    if index == 9 { return s"2" }
    if index == 10 { return s"3" }
    if index == 11 { return s"-" }
    if index == 12 { return s"0" }
    if index == 13 { return s"." }
    if index == 14 { return s"^" }
    return s"+"
}
fn calc_layout(width: int64, height: int64) {
    let w = num_max(420, width)
    let h = num_max(440, height)
    let area = gui_inset(w, h, 16)
    gui_move_to(1, gui_rect(16, 16, area.width, 24))
    gui_move_to(2, gui_rect(16, 48, area.width, 32))
    gui_move_to(3, gui_rect(16, 90, area.width, 30))
    gui_move_to(4, gui_rect(16, 126, area.width, 42))
    let actions = gui_rect(16, 176, area.width, 34)
    for i in 0..5 { gui_move_to(i + 5, gui_row(actions, i, 5, 6)) }
    let keys = gui_rect(16, 224, area.width, h - 240)
    for i in 0..16 {
        let row = gui_column(keys, i / 4, 4, 8)
        gui_move_to(16 + i, gui_row(row, i % 4, 4, 8))
    }
}
fn main() {
    let status = gui_open(s"Ramos Scientific Calculator", 540, 480)
    if status != 0 { stderr("Cannot open calculator window; check GUI dependencies/display\n")
        exit(1) }
    gui_label(1, 16, 16, 508, 24, s"Expression: sqrt(9) + 2^3; constants: pi e ans")
    gui_input(2, 16, 48, 508, 32, s"sqrt(9) + 2^3")
    gui_label(3, 16, 90, 508, 30, s"Result: 0")
    gui_label(4, 16, 126, 508, 42, s"Ready — sin cos tan ln log exp; trig uses radians")
    gui_button(5, 16, 176, 96, 34, s"Evaluate")
    gui_button(6, 120, 176, 96, 34, s"Clear")
    gui_button(7, 224, 176, 96, 34, s"sqrt(")
    gui_button(8, 328, 176, 96, 34, s"pi")
    gui_button(9, 432, 176, 92, 34, s"ans")
    for i in 0..16 { gui_button(16 + i, 16, 224, 80, 40, calc_key(i)) }
    calc_layout(540, 480)
    var ans = 0.0
    var running = true
    while running {
        let event = gui_event(-1)
        if event.kind == 1 { running = false }
        if event.kind == 3 { calc_layout(event.width, event.height) }
        if event.kind == 2 {
            if event.id == 5 {
                let result = calc_eval(gui_text(2), ans)
                if result.status != 0 { gui_set(4, calc_message(result)) }
                else { ans = result.value
                    gui_set(3, s"Result: " + math_text(ans, 10))
                    gui_set(4, s"Calculated; ans updated") }
            } else if event.id == 6 { gui_set(2, s"")
                gui_set(4, s"Cleared expression; ans retained") }
            else {
                var key = s""
                if event.id == 7 { key = s"sqrt(" }
                if event.id == 8 { key = s"pi" }
                if event.id == 9 { key = s"ans" }
                if event.id >= 16 && event.id <= 31 { key = calc_key(event.id - 16) }
                let text = gui_text(2) + key
                if buffer_len(to_bytes(text)) <= 4096 { gui_set(2, text) }
                else { gui_set(4, s"Expression limit: 4096 UTF-8 bytes") }
            }
        }
    }
    gui_check(gui_close())
}
